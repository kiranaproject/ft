<?xml version="1.0" encoding="UTF-8"?>
<project>
  <name>ft</name>
  <version>0.0.1-SNAPSHOT</version>
  <author>Dio Affriza</author>
  <license>MPL-2.0</license>

  <build>
    <mainSource>ft.pas</mainSource>
    <executableName>libft.so</executableName>
    <projectType>application</projectType>
    <outputDirectory>target</outputDirectory>

    <manualUnitPaths>true</manualUnitPaths>
    <unitPaths>
      <path>src/main/pascal</path>
    </unitPaths>
  </build>

  <test>
    <testSource>TestRunner.pas</testSource>
    <frameworkOptions>
      <option>--all --format=plain</option>
    </frameworkOptions>
  </test>
  
  <dependencies>
    <dependency>
      <name>fpgui-framework</name>
      <version>2.2.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <name>florialib</name>
      <version>0.0.1-SNAPSHOT</version>
    </dependency>
  </dependencies>
</project>

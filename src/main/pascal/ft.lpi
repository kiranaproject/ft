<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="ft"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="florialib"/>
      </Item>
      <Item>
        <PackageName Value="fpgui_toolkit"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="ft.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="ft.backend.x11.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Backend.X11"/>
      </Unit>
      <Unit>
        <Filename Value="ft.backend.xcb.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Backend.XCB"/>
      </Unit>
      <Unit>
        <Filename Value="ft.canvas.agg.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Canvas.Agg"/>
      </Unit>
      <Unit>
        <Filename Value="ft.widget.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Widget"/>
      </Unit>
      <Unit>
        <Filename Value="ft.widget.buttons.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Widget.Buttons"/>
      </Unit>
      <Unit>
        <Filename Value="ft.font.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Font"/>
      </Unit>
      <Unit>
        <Filename Value="ft.theme.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Theme"/>
      </Unit>
      <Unit>
        <Filename Value="ft.widget.switches.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Widget.Switches"/>
      </Unit>
      <Unit>
        <Filename Value="ft.widget.texts.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Widget.Texts"/>
      </Unit>
      <Unit>
        <Filename Value="ft.widget.entries.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Widget.Entries"/>
      </Unit>
      <Unit>
        <Filename Value="ft.widget.textareas.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Widget.TextAreas"/>
      </Unit>
      <Unit>
        <Filename Value="ft.widget.scrollbars.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Widget.ScrollBars"/>
      </Unit>
      <Unit>
        <Filename Value="ft.widget.containers.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Widget.Containers"/>
      </Unit>
      <Unit>
        <Filename Value="ft.widget.menus.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Widget.Menus"/>
      </Unit>
      <Unit>
        <Filename Value="ft.bitmap.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Bitmap"/>
      </Unit>
      <Unit>
        <Filename Value="ft.widget.images.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Widget.Images"/>
      </Unit>
      <Unit>
        <Filename Value="ft.blur.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Blur"/>
      </Unit>
      <Unit>
        <Filename Value="ft.css.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Css"/>
      </Unit>
      <Unit>
        <Filename Value="ft.svg.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Ft.Svg"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="../../../target/libft"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="../../../florialib/src/main/pascal"/>
      <UnitOutputDirectory Value="../../../target/units/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <RelocatableUnit Value="True"/>
    </CodeGeneration>
    <Linking>
      <Options>
        <ExecutableType Value="Library"/>
      </Options>
    </Linking>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>

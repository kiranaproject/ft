[Theme]
Name=gtk2
Author=Floria Project
Description=Classic GTK2 industrial gray with 3D bevels and subtle elevation
Style=classic
CornerRadius=3.0
Shadow=true
ShadowOffsetY=1.5
ShadowBlur=3.0
ShadowOpacity=0.12

[Light]
window.bg = #EDEDED
button.normal.plate = #E0E0E0
button.normal.border = #858585
button.normal.text = #1F1F1F
button.hover.plate = #EAEAEA
button.hover.border = #757575
button.hover.text = #0A0A0A
button.pressed.plate = #C8C8C8
button.pressed.border = #505050
button.pressed.text = #000000
button.toggled.plate = #D0D0D0
button.toggled.border = #4A6E9B
button.toggled.indicator = #4A6E9B
button.toggled.text = #101010

[Dark]
window.bg = #2E2E2E
button.normal.plate = #3A3A3A
button.normal.border = #262626
button.normal.text = #EAEAEA
button.hover.plate = #454545
button.hover.border = #333333
button.hover.text = #FFFFFF
button.pressed.plate = #2A2A2A
button.pressed.border = #1C1C1C
button.pressed.text = #FFFFFF
button.toggled.plate = #22354A
button.toggled.border = #386088
button.toggled.indicator = #386088
button.toggled.text = #FFFFFF
